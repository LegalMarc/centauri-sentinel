# centauri-sentinel — environment variable reference
# Copy to .env and set values. Only PRINTER_IP is required.
# All others have sane defaults.

# ---------------------------------------------------------------------------
# Printer
# ---------------------------------------------------------------------------

# IP address of the Centauri Carbon 2 on the LAN. Required.
PRINTER_IP=

# MQTT broker password (the printer's "access code" from Settings → Network).
PRINTER_ACCESS_CODE=123456

# MQTT broker port on the printer.
PRINTER_MQTT_PORT=1883

# MJPEG stream port on the printer.
PRINTER_MJPEG_PORT=8080

# MJPEG stream path on the printer.
PRINTER_MJPEG_PATH=/mjpeg

# ---------------------------------------------------------------------------
# Obico ML API
# ---------------------------------------------------------------------------

# Internal URL of the obico-ml container.
ML_API_URL=http://obico-ml:3333

# Path to the shared token file (written by the token-init container).
ML_API_TOKEN_FILE=/shared/token

# Number of consecutive detections before triggering a pause.
ML_CONFIRM_COUNT=3

# Seconds between frame grabs.
ML_POLL_INTERVAL_SECONDS=10

# Confidence threshold for a single-frame positive detection (0.0–1.0).
ML_SCORE_THRESHOLD=0.4

# ---------------------------------------------------------------------------
# Detection behaviour
# ---------------------------------------------------------------------------

# Seconds after print start before detection arms (skips purge / prime).
DETECTION_WARMUP_SECONDS=300

# Whether detection is enabled on startup (can be toggled at runtime).
DETECTION_ENABLED_DEFAULT=true

# Heartbeat age (seconds) at which the watcher is considered stalled.
WATCHER_STALL_SECONDS=60

# ---------------------------------------------------------------------------
# Telegram (optional — disabled if BOT_TOKEN is unset)
# ---------------------------------------------------------------------------

# Bot token from @BotFather.
# TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGabcdefg1234567890

# Chat ID to send alerts to. Required if BOT_TOKEN is set.
# TELEGRAM_CHAT_ID=-1001234567890

# Comma-separated list of authorised Telegram user IDs. Required if BOT_TOKEN set.
# TELEGRAM_USER_IDS=123456789,987654321

# ---------------------------------------------------------------------------
# ntfy (optional — disabled if NTFY_URL is unset)
# ---------------------------------------------------------------------------

# ntfy topic URL, e.g. https://ntfy.sh/your-long-random-topic
# NTFY_URL=https://ntfy.sh/your-long-random-topic

# Optional bearer token for self-hosted ntfy with auth.
# NTFY_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard authentication (optional — disabled if AUTH_USERNAME is unset)
# ---------------------------------------------------------------------------

# HTTP Basic Auth username for the status dashboard.
# AUTH_USERNAME=admin

# Plaintext password (hashed with bcrypt at startup for convenience, then discarded).
# AUTH_PASSWORD=yourplaintextpassword

# Pre-computed bcrypt hash (takes precedence over AUTH_PASSWORD). Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# AUTH_PASSWORD_BCRYPT=$2b$12$...

# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------

# Address to bind the web server on.
BIND_HOST=0.0.0.0

# Port to bind the web server on.
BIND_PORT=8000

# Set to true ONLY if you understand the security implications and have
# configured auth + TLS at your reverse proxy. See docs/threat-model.md.
EXTERNAL_BIND_ALLOWED=false

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Path to the SQLite database file (should be on a named volume).
DB_PATH=/data/sentinel.db
